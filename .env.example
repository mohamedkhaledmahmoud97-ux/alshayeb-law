# ======================================
# ALSHAYEB LAW Environment Configuration
# ======================================

# Application
APP_NAME=ALSHAYEB LAW
APP_ENV=development
APP_DEBUG=True

# API
HOST=127.0.0.1
PORT=8000

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3

# Vector Database
VECTOR_DB=FAISS

# Dataset
DATASET_PATH=datasets/

# Benchmarks
BENCHMARK_PATH=benchmarks/

# Outputs
OUTPUT_PATH=outputs/

# Logs
LOG_LEVEL=INFO
